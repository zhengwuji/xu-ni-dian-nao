# 统一行尾，避免 Windows 提交把 shell 脚本变成 CRLF 导致 CI 报
#   /usr/bin/env: 'bash\r': No such file or directory
* text=auto eol=lf

# shell / 配置文件必须是 LF
*.sh            text eol=lf
*.bash          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.properties    text eol=lf
*.gradle        text eol=lf
gradlew         text eol=lf

# PowerShell 用 CRLF
*.ps1           text eol=crlf

# Dart / Kotlin / Java / C 源码统一 LF
*.dart          text eol=lf
*.kt            text eol=lf
*.java          text eol=lf
*.c             text eol=lf
*.h             text eol=lf

# 二进制资源不要做行尾转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.zip           binary
*.gz            binary
*.xz            binary
*.jks           binary
*.keystore      binary
